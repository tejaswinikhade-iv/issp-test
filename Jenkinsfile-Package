pipeline{
    agent{
        label{
            label'jenkins-slave1'
        }
    }
     stages{
        stage('Package-Files'){
            steps{
                withCredentials([usernamePassword(credentialsId: 'maven-nexus-repo', usernameVariable: 'USERNAME', passwordVariable: 'PASSWORD')]){

                sh '''
                ls
                mkdir ISSP
                cp -r compose.yml ISSP
                cp -r config.yml ISSP
                sudo sudo tar -czvf ISSP-1.0.tar.gz ISSP
                curl -v -u "${USERNAME}:${PASSWORD}" --upload-file "ISSP-1.0.tar.gz" "https://devops.apps.inspiritvision.com/repo/repository/Infra-Self-Service-Portal/ISSP-1.0.tar.gz"
                rm -rf *
                '''
                }
            }
        }
     }
}